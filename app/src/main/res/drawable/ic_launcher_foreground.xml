<?xml version="1.0" encoding="utf-8"?>
<!--
  Clock face centered in the 108×108dp adaptive-icon safe zone.
  White disc, DeepTeal hands at 10:10, DeepTeal pivot dot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock body: white circle, center (54,54), radius 34 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,20 A34,34 0 1,0 54,88 A34,34 0 1,0 54,20Z"/>

    <!-- Hour hand: 10 o'clock (300° clockwise), length 18dp -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3A9085"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M54,54 L38,45"/>

    <!-- Minute hand: 2 o'clock (60° clockwise), length 24dp -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3A9085"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,54 L75,42"/>

    <!-- Center pivot dot, radius 4 -->
    <path
        android:fillColor="#3A9085"
        android:pathData="M54,50 A4,4 0 1,0 54,58 A4,4 0 1,0 54,50Z"/>

</vector>
